{
  "expo": {
    "name": "Türkiye Gezi Rehberi",
    "slug": "turkiye-gezi-rehberi",
    "version": "0.8.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF8F1"
    },
    "android": {
      "package": "com.turkiyegezirehberi.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#B8321F"
      },
      "permissions": [
        "INTERNET",
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "turkiye-gezi-rehberi-yeb7.netlify.app",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "com.turkiyegezirehberi.app",
      "supportsTablet": true
    },
    "plugins": [
      "@maplibre/maplibre-react-native",
      [
        "expo-image-picker",
        {
          "photosPermission": "Yorum ve öneri fotoğrafı seçmek için galerine erişmemiz gerekiyor.",
          "cameraPermission": "Gezdiğin yerin fotoğrafını çekmek için kameraya erişmemiz gerekiyor.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yakındaki yerleri göstermek ve yol tarifi için konumunu kullanırız. Konumun sunucuya kaydedilmez.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#B8321F",
          "defaultChannel": "default"
        }
      ]
    ],
    "scheme": "turkiyegezi"
  }
}